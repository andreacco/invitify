function AdminEditorRedirect() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const eventId = searchParams.get('eventId');

  useEffect(() => {
    if (eventId) {
      router.replace(`/dashboard/eventos/${eventId}/invitacion`);
      return;
