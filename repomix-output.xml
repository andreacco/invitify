  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setSuccess(false);

    try {
      const res = await fetch(`/api/event/${evento.id}/update`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
