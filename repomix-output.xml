import { useRouter } from 'next/navigation';
import { useSession } from 'next-auth/react';
import Link from 'next/link';

type DashboardEvento = {
  id: string;
  titulo: string;
  tipo: string;
  fecha: string;
  ubicacionRecepcion: string;
  esOwner?: boolean;
  esColaborador?: boolean;
  rolEnEvento?: string;
  _count?: { invitados: number };
