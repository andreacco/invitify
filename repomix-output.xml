        verificationToken: verificationToken // Guardamos el token
      },
      select: { id: true, email: true, nombre: true, apellido: true, isSuperAdmin: true }
    });

    // 🚀 CONEXIÓN REAL: Disparamos el correo asíncronamente justo aquí
