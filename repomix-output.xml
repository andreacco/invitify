import React from 'react';

interface CoverSVGProps {
  className?: string;
}

export default function CoverSVG({ className = '' }: CoverSVGProps) {
  return (
    <div className={`absolute inset-0 pointer-events-none ${className}`}>
      <img 
        src="/cover-real-1.png" 
        alt="Textura de Relieve"
        /* 
          LA MAGIA OCURRE AQUÍ:
          1. grayscale: Le quita el morado original a la foto dejándola en blanco y negro.
          2. mix-blend-overlay o mix-blend-luminosity: Fusiona las sombras y luces 3D de la foto con el color del sobre que está por debajo.
          3. opacity-80: Suaviza un poco el efecto para que no sea tan agresivo.
        */
        className="w-full h-full object-cover opacity-80"
      />
    </div>
  );
}

