      <p className="text-xs text-zinc-500 animate-pulse">Redirigiendo al editor...</p>
    </div>
  );
}

export default function AdminEditorPage() {
  return (
    <Suspense fallback={null}>
      <AdminEditorRedirect />
    </Suspense>
  );
}
